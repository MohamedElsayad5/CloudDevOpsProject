@Library('shared-library@main:jenkins/shared-library') _

pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        REPO = "myapp"

        // ECR repo URL (replace if needed)
        ECR_URL = "405161739227.dkr.ecr.us-east-1.amazonaws.com/myapp"

        // Versioning strategy (BEST PRACTICE)
        TAG = "${BUILD_NUMBER}"
        
        // K8s manifest path
        K8S_FILE = "k8s/Deployment.yaml"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/MohamedElsayad5/FinalProject.git'
            }
        }

        stage('Build Image') {
            steps {
                script {
                    buildImage(env.REPO, env.TAG)
                }
            }
        }

        stage('Scan Image (Trivy)') {
            steps {
                script {
                    scanImage(env.REPO, env.TAG)
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    pushECR(env.ECR_URL, env.REPO, env.TAG)
                }
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                script {
                    updateManifest(
                        env.K8S_FILE,
                        "${env.ECR_URL}:${env.TAG}"
                    )
                }
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed. Check logs."
        }
    }
}