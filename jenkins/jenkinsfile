@Library('shared-library@main:jenkins/shared-library') _

pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        REPO = "myapp"
    }

    stages {

        stage('Checkout') {
            steps {
                git 'https://github.com/MohamedElsayad5/FinalProject.git'
            }
        }

        stage('Build Image') {
            steps {
                script {
                    buildImage()
                }
            }
        }

        stage('Scan Image') {
            steps {
                script {
                    scanImage()
                }
            }
        }

        stage('Push to ECR') {
            steps {
                script {
                    pushECR()
                }
            }
        }

        stage('Update Manifest') {
            steps {
                script {
                    updateManifest()
                }
            }
        }
    }
}