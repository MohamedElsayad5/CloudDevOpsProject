@Library('shared-library@main:jenkins/shared-library') _

pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        REPO = "myapp"

        ECR_URL = "405161739227.dkr.ecr.us-east-1.amazonaws.com/myapp"

        TAG = "${BUILD_NUMBER}"

        K8S_FILE = "k8s/Deployment.yaml"
        APP_DIR = "FinalProject"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout([$class: 'GitSCM',
                    branches: [[name: 'main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/MohamedElsayad5/CloudDevOpsProject.git',
                        credentialsId: 'github-token'
                    ]]
                ])
            }
        }

        stage('Build Image') {
            steps {
                sh """
                    cd ${APP_DIR} && \
                    docker build -t ${REPO}:${TAG} .
                """
            }
        }

        stage('Scan Image (Trivy)') {
            steps {
                sh """
                    trivy image ${REPO}:${TAG}
                """
            }
        }

        stage('Login to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_URL.split('/')[0]}
                """
            }
        }

        stage('Push to ECR') {
            steps {
                sh """
                    docker tag ${REPO}:${TAG} ${ECR_URL}:${TAG}
                    docker push ${ECR_URL}:${TAG}
                """
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                    sed -i 's|image: .*|image: ${ECR_URL}:${TAG}|g' ${K8S_FILE}
                """
            }
        }

    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed!"
        }
    }
}