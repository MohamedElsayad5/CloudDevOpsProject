@Library('shared-library') _

pipeline {
    agent any
    
    triggers {
        githubPush() 
    }

    environment {
        AWS_REGION = "us-east-1"
        REPO_NAME = "myapp"
        ECR_URL = "405161739227.dkr.ecr.us-east-1.amazonaws.com/myapp"
        TAG = "${BUILD_NUMBER}"
        K8S_DIR = "k8s"
        GIT_REPO_URL = "github.com/MohamedElsayad5/CloudDevOpsProject.git"
        GIT_CRED_ID = "github-token" 
    }

    stages {
        stage('Checkout & Anti-Loop Check') {
            steps {
                script {
                    checkout scm
                   
                    def commitMsg = sh(script: "git log -1 --pretty=%B", returnStdout: true).trim()
                    echo "Last commit message: ${commitMsg}"
                    
                    
                    if (commitMsg.contains("[skip ci]")) {
                        echo "Anti-loop trigger: skipping this build."
                        currentBuild.result = 'SUCCESS'
                        
                        error("Stopping build to prevent infinite loop.")
                    }
                }
            }
        }

        stage('Build Image') {
            steps {
                sh "docker build -t ${REPO_NAME}:${TAG} -f FinalProject/Dockerfile FinalProject"
            }
        }

        stage('Push to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_URL.split('/')[0]}
                    docker tag ${REPO_NAME}:${TAG} ${ECR_URL}:${TAG}
                    docker push ${ECR_URL}:${TAG}
                """
            }
        }

        stage('Update Manifest & Push to Git') {
            steps {
                script {
                    
                    sh "sed -i 's|image: .*|image: ${ECR_URL}:${TAG}|g' ${K8S_DIR}/Deployment.yaml"
                    
                   
                    withCredentials([usernamePassword(credentialsId: "${GIT_CRED_ID}", passwordVariable: 'GIT_PASSWORD', usernameVariable: 'GIT_USERNAME')]) {
                        sh """
                            git config user.email "jenkins@example.com"
                            git config user.name "Jenkins CI"
                            git add ${K8S_DIR}/Deployment.yaml
                            git commit -m "Update image tag to ${TAG} [skip ci]" || echo "No changes to commit"
                            git push https://${GIT_USERNAME}:${GIT_PASSWORD}@${GIT_REPO_URL} HEAD:main
                        """
                    }
                }
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline finished successfully!"
        }
        aborted {
            echo "ℹ️ Pipeline stopped early to prevent loop."
        }
    }
}