@Library('shared-library') _

pipeline {
    agent any

    environment {
        AWS_REGION = "us-east-1"
        REPO = "myapp"
        ECR_URL = "405161739227.dkr.ecr.us-east-1.amazonaws.com/myapp"
        TAG = "${BUILD_NUMBER}"
        K8S_FILE = "k8s/Deployment.yaml"
        APP_DIR = "FinalProject"
        CLUSTER_NAME = "your-eks-cluster-name"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Image') {
            steps {
                script {
                    // هذا السطر سيكشف لنا كل شيء
                    sh "ls -la" 
                    sh "find . -name Dockerfile"
                    
                    // سنقوم بالبناء باستخدام المسار الذي سيجده أمر find
                    sh "docker build -t ${REPO}:${TAG} -f FinalProject/Dockerfile FinalProject"
                }
            }
        }

        stage('Login to ECR') {
            steps {
                sh """
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_URL.split('/')[0]}
                """
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh """
                    docker tag ${REPO}:${TAG} ${ECR_URL}:${TAG}
                    docker push ${ECR_URL}:${TAG}
                """
            }
        }

        stage('Update Kubernetes Manifest') {
            steps {
                sh """
                    sed -i 's|image: .*|image: ${ECR_URL}:${TAG}|g' ${K8S_FILE}
                """
            }
        }

        stage('Deploy to EKS') {
            steps {
                sh """
                    aws eks update-kubeconfig --name ${CLUSTER_NAME} --region ${AWS_REGION}
                    kubectl apply -f k8s/
                """
            }
        }
    }

    post {
        success {
            echo "✅ Pipeline completed successfully!"
        }

        failure {
            echo "❌ Pipeline failed!"
        }
    }
}